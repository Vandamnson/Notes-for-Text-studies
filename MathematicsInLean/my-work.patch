+-- ░░ Tier 1 — constructive: intro / rcases / exact only, no by_contra ░░
+
+example (h : ¬∃ x, P x) : ∀ x, ¬P x := by
+  intro x Px
+  apply h
+  exact ⟨ x, Px⟩
+
+
+example (h : ∀ x, P x → Q x) (h₂ : ∃ x, P x) : ∃ x, Q x := by
+  rcases h₂ with ⟨ x, Px⟩
+  exact ⟨ x, h x Px ⟩
+
+
+
+example (h : ¬∃ x, P x ∧ Q x) : ∀ x, P x → ¬Q x := by
+  intro x Px Qx
+  apply h
+  exact ⟨ x, Px, Qx⟩
+
+example (h : ∃ x, ¬P x) (h₂ : ∀ x, P x ∨ Q x) : ∃ x, Q x := by
+  rcases h with ⟨ x, Px ⟩
+  rcases h₂ x with Pxx | Qxx
+  · exact absurd Pxx Px
+  · exact ⟨ x, Qxx⟩
+
+example (h : ¬(p ∨ q)) : ¬p ∧ ¬q := by
+  apply And.intro
+  · intro hp
+    apply h
+    apply Or.inl
+    apply hp
+  · intro hq
+    apply h
+    apply Or.inr
+    apply hq
+
+
+example (h : p ∧ ¬q) : ¬(p → q) := by
+  intro hpq
+  rcases h with ⟨ hp, hq ⟩
+  apply hq
+  apply hpq
+  apply hp
+
